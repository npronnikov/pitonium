{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "packages/**/*.ts", "apps/**/*.ts", "db/schema.ts", "tests/**/*.ts", "vite.standalone.config.ts", "vite.api.config.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist", "data", "backups"]
}
