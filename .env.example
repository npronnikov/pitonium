# Local Node 24 server. Copy to .env; start with:
# node --env-file=.env dist/api/server.mjs
# For development: node --env-file=.env scripts/dev-local.mjs
HOST=127.0.0.1
PORT=8787
PITON_PUBLIC_ORIGIN=http://localhost:8787
PITON_ALLOWED_ORIGINS=http://127.0.0.1:8787
PITON_DB_PATH=data/piton.sqlite
PITON_STATIC_DIR=dist/standalone
PITON_TIME_ZONE=UTC

# Optional chat-completions-compatible tutor. Leave all blank for authored hints.
# Keep API credentials on the server; never use a VITE_ prefix for secrets.
TUTOR_ENDPOINT=
TUTOR_API_KEY=
TUTOR_MODEL=
