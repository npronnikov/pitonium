{
  "name": "piton-v5-portable",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "ПИТОН — Python через игру, создание и практику. Переносимый Node 24 / SQLite вариант.",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "build": "node scripts/build-local.mjs",
    "build:api": "vite build --config vite.api.config.ts",
    "start": "node dist/api/server.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx apps/api/db-cli.ts migrate",
    "db:check": "node --import tsx apps/api/db-cli.ts check",
    "db:backup": "node --import tsx apps/api/db-cli.ts backup",
    "db:restore": "node --import tsx apps/api/db-cli.ts restore",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:api": "node --import tsx --test tests/api*.test.ts",
    "test:runtime": "node --import tsx --test tests/runtime*.test.ts",
    "test:curriculum": "node --import tsx --test tests/curriculum*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "monaco-editor": "0.55.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "pyodide": "314.0.7",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
